{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1080px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "linho",        "color": "#F5EFE6", "name": "Linho"        },
        { "slug": "creme",        "color": "#FBF8F3", "name": "Creme"        },
        { "slug": "areia",        "color": "#E7DBC9", "name": "Areia"        },
        { "slug": "argila",       "color": "#BD5D3A", "name": "Argila"       },
        { "slug": "argila-fundo", "color": "#9A4A2D", "name": "Argila Fundo" },
        { "slug": "ambar",        "color": "#E8972C", "name": "Âmbar"        },
        { "slug": "cafe",         "color": "#2B2420", "name": "Café"         },
        { "slug": "grafite",      "color": "#141210", "name": "Grafite"      },
        { "slug": "cinza",        "color": "#8C8378", "name": "Cinza"        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Orelega One\", Georgia, serif",
          "name": "Orelega One",
          "slug": "orelega-one"
        },
        {
          "fontFamily": "\"Hanken Grotesk\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "Hanken Grotesk",
          "slug": "hanken-grotesk"
        }
      ],
      "fontSizes": [
        { "slug": "small",   "size": "13px",               "name": "Small"  },
        { "slug": "medium",  "size": "16px",               "name": "Medium" },
        { "slug": "large",   "size": "clamp(18px,2.1vw,23px)", "name": "Large" },
        { "slug": "x-large", "size": "clamp(28px,4vw,44px)",  "name": "X-Large" },
        { "slug": "xx-large","size": "clamp(32px,5vw,56px)",  "name": "XX-Large" }
      ]
    },
    "spacing": {
      "spacingScale": { "operator": "*", "increment": 1.5, "steps": 7, "mediumStep": 1, "unit": "rem" },
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "#F5EFE6",
      "text": "#2B2420"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--hanken-grotesk)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--orelega-one)",
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "lineHeight": "1.06"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--orelega-one)",
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "lineHeight": "1.1"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--orelega-one)",
          "fontSize": "clamp(20px,2.5vw,30px)",
          "lineHeight": "1.15"
        }
      },
      "link": {
        "color": { "text": "#BD5D3A" },
        ":hover": { "color": { "text": "#9A4A2D" } }
      },
      "button": {
        "color": {
          "background": "#BD5D3A",
          "text": "#F5EFE6"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--hanken-grotesk)",
          "fontWeight": "600"
        },
        "border": { "radius": "40px" },
        ":hover": {
          "color": { "background": "#9A4A2D" }
        }
      }
    },
    "blocks": {
      "core/site-logo": {
        "layout": { "selfStretch": "fit" }
      }
    }
  }
}
